<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================== -->
    <!-- PERMISSIONS -->
    <!-- ===================================================== -->

    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Camera (Odometer OCR) -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>

    <!-- Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Foreground Tracking -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Activity Recognition (Auto Drive Detection) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>

    <!-- Local Notifications (recordatorio de viaje olvidado + resumen semanal) -->
    <!-- Requerido en Android 13+ para mostrar notificaciones. Sin permiso de
         alarma exacta a propósito: ambos recordatorios usan scheduling
         inexacto (AndroidScheduleMode.inexactAllowWhileIdle), que no
         requiere SCHEDULE_EXACT_ALARM ni review especial de Play Store —
         ninguno de los dos es time-critical. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Gig app detection (premium auto-detect, Android only): a
         "special access" permission, never a runtime dialog. The user
         must grant it manually from Settings (see
         MainActivity.openUsageAccessSettings). tools:ignore is required
         because Google Play statically flags PACKAGE_USAGE_STATS as a
         protected/sensitive permission; ignored deliberately since this
         is exactly the declared, disclosed use case. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- ===================================================== -->
    <!-- APPLICATION -->
    <!-- ===================================================== -->

    <application
        android:label="ControlMiles"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="false"
        android:fullBackupContent="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Geolocator Foreground Service -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            android:foregroundServiceType="location"
            android:exported="false"/>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <!-- ===================================================== -->
    <!-- QUERIES (Flutter Text Processing) -->
    <!-- ===================================================== -->

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Gig app detection: Android 11+ filters package visibility by
             default (QUERY_ALL_PACKAGES is restricted on Play Store), so
             only the specific packages this feature actually checks are
             declared here, matching the verified catalog in the
             gig_app_packages DB table, not a request for blanket
             visibility into everything installed. -->
        <package android:name="com.ubercab.driver"/>
        <package android:name="com.lyft.android.driver"/>
        <package android:name="com.doordash.driverapp"/>
        <package android:name="com.instacart.shopper"/>
        <package android:name="com.amazon.rabbit"/>
        <package android:name="com.amazon.flex.rabbit"/>
        <package android:name="com.roadie.drive.android.app"/>
        <package android:name="com.shipt.shopper"/>
        <package android:name="com.yazam.empower.driver"/>
        <package android:name="com.vehotechnologies.Driver"/>
        <package android:name="com.axlehire.drive"/>
        <package android:name="com.walmart.sparkdriver"/>
        <package android:name="com.grubhub.driver"/>
        <package android:name="com.gopuff.godrive2.live"/>
        <package android:name="com.verifone.curb.driver"/>
        <package android:name="com.curb.one"/>
        <package android:name="com.pointpickup.partner"/>
        <package android:name="com.skipcart.app.mobile.prod"/>
        <package android:name="com.dispatchit"/>
        <package android:name="com.deliverthat.driver"/>
        <package android:name="com.hopskipdrive.driver"/>
        <package android:name="co.goshare.driverapp"/>
        <package android:name="com.Curri.Driver"/>
        <package android:name="com.Curri.RouteDriver"/>
    </queries>

</manifest>
