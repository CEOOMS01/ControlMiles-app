<?xml version="1.0" encoding="utf-8"?>
<!--
  This 16% inset dated back to this repo's very first commit, never
  touched by either logo redesign since (576e96f, 1aa22b4). Both of
  those regenerated ic_launcher_foreground.png itself to already be
  full bleed (measured: 99 to 100% of its own canvas is non transparent
  content, deliberately edge to edge, no built in padding), but this
  XML kept adding a SECOND, unrelated 16% margin on top of an image
  that no longer needed one, which is exactly why the launcher icon
  looked like it did not cover the edges even after the logo itself
  was fixed. Removed (0% inset): the foreground PNG is already the
  full intended icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
