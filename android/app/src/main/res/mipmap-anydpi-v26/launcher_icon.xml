<?xml version="1.0" encoding="utf-8"?>
<!--
  NO <inset> HERE, ON PURPOSE.

  flutter_launcher_icons (v0.14.4) re-adds a 16% inset to this file EVERY time
  icons are regenerated (it is the tool's own default template, not something
  added by hand). It has to be removed again after every
  `dart run flutter_launcher_icons`. This is not a one-time fix.

  Why it has to go: the Android safe zone is already baked into the foreground
  ASSET itself. assets/images/logo_controlmiles_launcher_foreground.png is a
  1024x1024 square whose glyph occupies 52% of the canvas height, centered --
  comfortably inside the 72dp-of-108dp (66.7%) area every OEM mask is
  guaranteed to show. Applying the tool's inset on top of that padding would
  draw the glyph into only 68% of the canvas, shrinking it to ~35% of the icon
  and leaving it visibly undersized in the launcher.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background"/>
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
