# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# Security baseline (2026-08-28): no .env file exists in this project today
# -- all secrets live server-side in Supabase Edge Function env vars, never
# in the Flutter client -- but this is a zero-cost guard against one ever
# being committed by accident if local tooling adds one later.
.env
.env.*
!.env.example
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
